{
  "name": "dhulka",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "pnpm --filter @dhulka/web dev",
    "build": "pnpm --filter @dhulka/web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:db": "pnpm --filter @dhulka/db-tests test",
    "test:e2e": "pnpm --filter @dhulka/web test:e2e",
    "format": "prettier --write .",
    "create-super-admin": "tsx scripts/create-super-admin.ts",
    "reset-admin-password": "tsx scripts/reset-admin-password.ts",
    "db:login": "supabase login",
    "db:link": "supabase link",
    "db:push": "supabase db push --include-seed",
    "db:types": "supabase gen types typescript --linked --schema public > packages/core/src/database.types.ts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@types/node": "^22.20.5",
    "dotenv": "^16.4.7",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "supabase": "^2.121.0"
  }
}

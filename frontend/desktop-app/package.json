{
  "name": "lrmis-desktop",
  "productName": "LRMIS",
  "version": "1.0.0",
  "private": true,
  "description": "LRMIS for staff computers: the whole window is protected, so screenshots and screen sharing of it come out black.",
  "main": "main.js",
  "author": "Banadir Regional Administration",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "so.banadir.lrmis",
    "productName": "LRMIS",
    "files": [
      "main.js",
      "config.json",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "identity": null,
      "extendInfo": {
        "NSCameraUsageDescription": "LRMIS uses the camera to take pictures in staff chat."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}

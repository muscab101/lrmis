# ── Supabase ────────────────────────────────────────────────────────────────
# From `supabase start` (local) or Project Settings → API (hosted).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Server only. Never prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# development | staging | production (shows a DEV / STAGING badge in the top bar)
NEXT_PUBLIC_APP_ENV=development
# Staff idle timeout in minutes
SESSION_IDLE_MINUTES=30

# ── Google sign-in for existing staff (optional) ───────────────────────────
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# ── First Super Admin ───────────────────────────────────────────────────────
# Option A: `pnpm create-super-admin` reads these.
SUPER_ADMIN_EMAIL=you@gmail.com
SUPER_ADMIN_PASSWORD=change-me-to-a-strong-password
SUPER_ADMIN_NAME=Super Admin
# Option B: open /so/setup once and enter this token (page locks itself afterwards).
SETUP_TOKEN=generate-a-long-random-string

# ── E2E tests (Playwright) ──────────────────────────────────────────────────
E2E_BASE_URL=http://localhost:3000

# --- Payments (Phase 7) — server only; providers are offered only when configured AND switched on in /payments → Providers.
# WaafiPay (EVC Plus, Zaad, Sahal, eDahab)
WAAFIPAY_API_URL=https://api.waafipay.net/asm
WAAFIPAY_MERCHANT_UID=
WAAFIPAY_API_USER_ID=
WAAFIPAY_API_KEY=
# HMAC-SHA256 secret for merchant-number / USSD notifications to /api/payments/webhook/waafipay (header x-waafi-signature)
WAAFIPAY_WEBHOOK_SECRET=
# Stripe (diaspora cards; only with an entity/partner in a supported country). Webhook: /api/payments/webhook/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Development only: "test" provider on /pay pages. Never set in production.
PAYMENTS_TEST_MODE=
PAYMENTS_TEST_SECRET=

# --- Messages (Phase 10) ---
# log (dev only: prints a masked line) | twilio. Unset in production = nothing is sent.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Bearer token the scheduler sends to /api/messages/dispatch (at least 24 characters).
MESSAGES_DISPATCH_SECRET=

# --- Reporting assistant (Phase 10) ---
# Leave empty to switch the assistant off.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5-5

# --- USSD and WhatsApp (Phase 11) ---
# Callback key appended to the USSD gateway URL: /api/ussd?key=... (at least 24 characters).
USSD_CALLBACK_KEY=
# WhatsApp Cloud API: webhook verify token, app secret (signature check), sender phone id and token.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

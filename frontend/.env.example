# ── Supabase ────────────────────────────────────────────────────────────────
# From `supabase start` (local) or Project Settings → API (hosted).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Server only. Never prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# development | staging | production (shows a DEV / STAGING badge in the top bar)
NEXT_PUBLIC_APP_ENV=development
# Staff idle timeout in minutes
SESSION_IDLE_MINUTES=30

# ── Google sign-in for existing staff (optional) ───────────────────────────
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# ── First Super Admin ───────────────────────────────────────────────────────
# Option A: `pnpm create-super-admin` reads these.
SUPER_ADMIN_EMAIL=you@gmail.com
SUPER_ADMIN_PASSWORD=change-me-to-a-strong-password
SUPER_ADMIN_NAME=Super Admin
# Option B: open /so/setup once and enter this token (page locks itself afterwards).
SETUP_TOKEN=generate-a-long-random-string

# ── E2E tests (Playwright) ──────────────────────────────────────────────────
E2E_BASE_URL=http://localhost:3000
